Row: [{"productId":114034,"productName":"Onitsuka Tiger Mexico 66 SD PF White Lagoon 7A Premium Womens Platform Sneakers D-2140","productDateCreation":"2026-10-08 00:07:01","productLastUpdated":1795157284787,"productPrice":null,"productPriceWithoutDiscount":null,"productOriginalPrice":2399,"productFetchedFrom":"https://benzershoes.jdwebconnect.com","productUrl":"https://benzershoes.jdwebconnect.com/products/SKU1791364028587729","featuredimg":"https://assets.jdwebshop.com/products/images/e0ca98a8-37f4-479a-b286-6c0a141a790a.webp","imageUrl":"[\"https://assets.jdwebshop.com/products/images/e0ca98a8-37f4-479a-b286-6c0a141a790a.webp\"]","videoUrl":"https://assets.jdwebshop.com/products/videos/1791387625_SXxt6h.mp4","productShortDescription":"<div class=\"\n      [&amp;_ul]:list-disc\n      [&amp;_ul]:pl-6\n      [&amp;_ul]:text-left\n      [&amp;_ol]:list-disc\n      [&amp;_ol]:pl-6\n      [&amp;_ol]:text-left\n      [&amp;_a]:text-blue-600\n      [&amp;_a]:underline\n      hover:[&amp;_a]:text-blue-800\n      [&amp;_p]:text-left [&amp;_p]:opacity-90\n      [&amp;_h1]:text-left [&amp;_h1]:mb-2\n      [&amp;_h2]:text-left [&amp;_h2]:mb-2\n      [&amp;_h3]:text-left [&amp;_h3]:mb-2\n      [&amp;_h4]:text-left [&amp;_h4]:mb-2\n      [&amp;_h5]:text-left [&amp;_h5]:mb-2\n      [&amp;_h6]:text-left [&amp;_h6]:mb-2\n\n      /* Responsive heading and paragraph font sizes, margin below */\n      [&amp;_h1]:text-2xl md:[&amp;_h1]:text-3xl [&amp;_h1]:font-bold [&amp;_h1]:mb-4\n      [&amp;_h2]:text-xl md:[&amp;_h2]:text-2xl [&amp;_h2]:font-semibold [&amp;_h2]:mb-4\n      [&amp;_h3]:text-lg md:[&amp;_h3]:text-xl [&amp;_h3]:font-semibold [&amp;_h3]:mb-4\n      [&amp;_h4]:text-base md:[&amp;_h4]:text-lg [&amp;_h4]:font-semibold [&amp;_h4]:mb-4\n      [&amp;_h5]:text-base md:[&amp;_h5]:text-md [&amp;_h5]:font-medium [&amp;_h5]:mb-4\n      [&amp;_h6]:text-sm md:[&amp;_h6]:text-base [&amp;_h6]:font-medium [&amp;_h6]:mb-4\n      [&amp;_p]:text-base md:[&amp;_p]:text-lg [&amp;_p]:mb-3 [&